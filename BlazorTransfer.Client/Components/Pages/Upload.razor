@page "/"
@rendermode InteractiveServer

@using BlazorTransfer.Client.Services
@using BlazorTransfer.Shared

@inject TransferService Transfer

<h1>Upload Files</h1>

<InputFile OnChange="OnFilesSelected" multiple />

@if (result == null && errorMessage == null)
{
    <p>Waiting for upload...</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (result != null)
{
    <h3>Download link</h3>
    //<a href="@result.DownloadUrl" target="_blank">@result.DownloadUrl</a>
    <div class="input-group mt-2">
        <input class="form-control"
            value="@result.DownloadUrl"
            readonly />
        <button class="btn btn-primary" @onclick="CopyLink">
            Copy
        </button>
</div>

}

@code {
    FileUploadResult? result;
    string? errorMessage;

    async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        Console.WriteLine("OnFilesSelected fired");   
        try
        {
            var files = e.GetMultipleFiles().ToArray();
            result = await Transfer.UploadAsync(files);
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERROR: " + ex.ToString());
            errorMessage = ex.Message;
        }
    }

        async Task CopyLink()
    {
        await ClipboardCopy(result!.DownloadUrl);
    }

    [Inject]
    public IJSRuntime JS { get; set; } = default!;

    public async Task ClipboardCopy(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}
