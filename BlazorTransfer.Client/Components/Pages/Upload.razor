@page "/"
@rendermode InteractiveServer

@using BlazorTransfer.Client.Services
@using BlazorTransfer.Shared

@inject TransferService Transfer
@inject IJSRuntime JS

<h1 class="mb-4">Upload Files</h1>

<div class="upload-container">

    <!-- Drag & Drop Box -->
    <div class="drop-zone @(isDragging ? "dragging" : "")"
         @ondragover:preventDefault="true"
         @ondragover="() => isDragging = true"
         @ondragleave="() => isDragging = false"
         @ondrop:preventDefault="true"
         @ondrop="OnDrop">

        <p class="text-muted">Drag & drop files here</p>
        <p class="text-muted">or click to choose files</p>

        <!-- Hidden actual file picker -->
        <InputFile OnChange="OnFilesSelected" multiple class="file-input" />
    </div>

</div>

@if (result == null && errorMessage == null)
{
    <p class="mt-3 text-secondary">Waiting for upload...</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (result != null)
{
    <h3 class="mt-4">Download link</h3>
    
    <div class="input-group mt-2">
        <input class="form-control"
            value="@result.DownloadUrl"
            readonly />
        <button class="btn btn-primary" @onclick="CopyLink">
            Copy
        </button>
</div>

}

@code {
    FileUploadResult? result;
    string? errorMessage;
    bool isDragging = false;

    async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        Console.WriteLine("OnFilesSelected fired");   
        try
        {
            var files = e.GetMultipleFiles().ToArray();
            result = await Transfer.UploadAsync(files);
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERROR: " + ex.ToString());
            errorMessage = ex.Message;
        }
    }
    void OnDragOver(DragEventArgs e)
    {
        
        isDragging = true;
    }
        void OnDragLeave(DragEventArgs e)
    {
        isDragging = false;
    }
        async Task OnDrop(DragEventArgs e)
    {
       
await JS.InvokeVoidAsync("document.querySelector('.file-input').click()");
        isDragging = false;
    }

        async Task CopyLink()
    {
        await ClipboardCopy(result!.DownloadUrl);
    }

    //[Inject]
    //public IJSRuntime JS { get; set; } = default!;

    public async Task ClipboardCopy(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}
