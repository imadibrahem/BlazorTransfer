@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms

@using BlazorTransfer.Client.Services
@using BlazorTransfer.Shared

@inject TransferService Transfer
@inject IJSRuntime JS
@inject NavigationManager Nav


<div class="upload-box">
    <h1 class="mb-4">Upload Files</h1>

<div class="upload-container">

    <div class="drop-zone @(isDragging ? "dragging" : "")"
         @ondragover:preventDefault="true"
         @ondragenter="() => isDragging = true"
         @ondragleave="() => isDragging = false">
         
        <p class="text-muted small">Max file size allowed: @(MaxFileSize / (1024 * 1024)) MB</p>
        <p class="text-muted mb-1">Drag & drop files here</p>
        <p class="text-muted small">(Release to upload)</p>

        <InputFile OnChange="OnFilesSelected" multiple class="file-input" />
        <div class="mt-3">
            <InputFile OnChange="OnFilesSelected" multiple class="form-control" />
        </div>
      
    </div>

</div>

@if (progressItems.Any())
{
    <div class="mt-4">
        @foreach (var item in progressItems)
        {
            <div class="mb-3">
                <strong>@item.FileName</strong>
                <div class="progress">
                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @item.Percentage%">
                        @item.Percentage%
                    </div>
                </div>
            </div>
        }
    </div>
}



@if (result == null && errorMessage == null)
{
    <p class="mt-3 text-secondary">Waiting for upload...</p>
    <p class="text-muted small">Total size allowed: @(MaxTotalUploadSize / (1024 * 1024)) MB</p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (result != null)
{
    <h3 class="mt-4">Download link</h3>
    
    <div class="input-group mt-2">
        <input class="form-control"
            value="@PageDownloadUrl"
            readonly />
        <button class="btn btn-primary" @onclick="CopyLink">
            Copy
        </button>
    </div>
    <p class="text-muted">
            Total size: @(totalSize / (1024 * 1024)) MB /
            @(MaxTotalUploadSize / (1024 * 1024)) MB
    </p>

}
</div>

@code {
    FileUploadResult? result;
    string? errorMessage;
    string PageDownloadUrl =>
        result == null
            ? string.Empty
            : $"{Nav.BaseUri}download/{result.TransferId}";
    bool isDragging = false;
    const long MaxFileSize = 2L * 1024 * 1024 * 1024; // 2 GB
    const long MaxTotalUploadSize = 5L * 1024 * 1024 * 1024; // 5 GB
    long totalSize;


    List<UploadProgressItem> progressItems = new();


    async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        result = null;
        progressItems.Clear();

        var files = e.GetMultipleFiles();
        totalSize = 0L;

        foreach (var file in files)
        {
            if (file.Size > MaxFileSize)
            {
                errorMessage = $"File '{file.Name}' exceeds the 2 GB limit.";
                return;
            }
            totalSize += file.Size;
        }
        if (totalSize > MaxTotalUploadSize)
        {
            errorMessage = $"Total upload size exceeds the 5 GB limit.";
            return;
        }  

        foreach (var file in files)
        {
            progressItems.Add(new UploadProgressItem
            {
                FileName = file.Name,
                TotalBytes = file.Size
            });
        }
        try
        {
            result = await Transfer.UploadSequentialAsync(
                files,
                (fileName, uploaded, total) =>
                 {
                    var item = progressItems.First(x => x.FileName == fileName);
                    item.UploadedBytes = uploaded;
                    InvokeAsync(StateHasChanged);
                });
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERROR: " + ex);
            errorMessage = "Upload failed.";
        }
    }


        async Task CopyLink()
    {
        await ClipboardCopy(PageDownloadUrl);
    }


    public async Task ClipboardCopy(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }
}
